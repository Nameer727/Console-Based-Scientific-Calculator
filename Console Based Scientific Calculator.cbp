}

double cm_in(double a)
{
    return a/2.54;
}

double in_cm(double a)
{
    return a*2.54;
}

double trig_cot_invers(double a)
{
    return atan(1.0/a);
}

double trig_cot(double redian)
{
    return (1.0/tan(redian));
}

double trig_sec_invers(double a)
{
    return acos(1.0/a);
}

double trig_sec(double redian)
{
    return (1.0/cos(redian));
}

double trig_cosec_invers(double a)
{
    return asin(1.0/a);
}

double trig_cosec(double redian)
{
    return (1.0/sin(redian));
}

double trig_tan_invers(double a)
{
    return atan(a);
}

double trig_tan(double redian)
{
    return tan(redian);
}

double trig_cos_invers(double a)
{
    return acos(a);
}

double trig_cos(double redian)
{
    return cos(redian);
}

double trig_sin_invers(double a)
{
    return asin(a);
}

double trig_sin(double redian)
{
    return sin(redian);
}

double n_base_log(double a, double n)
{
    return (log(a)/log(n));
}

double ten_base_log(double a)
{
    return log10(a);
}

double e_base_log(double a)
{
    return log(a);
}

double N_Root(double a, double n)
{
    return pow(a, (1.0/n));
}

double cube_root(double a)
{
    return cbrt(a);
}

double square_root(double a)
{
    return sqrt(a);
}

double powern(double a, double b)
{
    return pow(a, b);
}

double divide(double a, double b)
{
    return a/b;
}

double multiply4(double a, double b, double c, double d)
{
    return a*b*c*d;
}

double multiply3(double a, double b, double c)
{
    return a*b*c;
}

double multiply2(double a, double b)
{
    return a*b;
}

double sub(double a, double b)
{
    return a-b;
}

double sum4(double a, double b, double c, double d)
{
    return a+b+c+d;
}

double sum3(double a, double b, double c)
{
    return a+b+c;
}

double sum2(double a, double b)
{
    return a+b;
}

