#include <iostream>
#include <cmath>
#define PI 3.141592653589793

using namespace std;

long double cal_j(long double a)
{
    return a*(4.1858);
}

long double j_cal(long double a)
{
    return a/(4.1858);
}

long double C_F(long double a)
{
    return ((9*a)/5);
}

long double F_C(long double a)
{
    return ((5*a)/9);
}

long double kpa_lbf_in_sqr(long double a)
{
    return a/(6.894757);
}

long double lbf_in_sqr_kpa(long double a)
{
    return a*(6.894757);
}

long double j_kgf_m(long double a)
{
    return a/(9.80665);
}

long double kgf_m_j(long double a)
{
    return a*(9.80665);
}

long double pa_kgf_cm_sqr(long double a)
{
    return a/(98066.5);
}

long double kgf_cm_sqr_pa(long double a)
{
    return a*(98066.5);
}

long double kw_hp(long double a)
{
    return a*(1.341021859);
}

long double hp_kw(long double a)
{
    return a/(1.341021859);
}

long double pa_mmHg(long double a)
{
    return a/(133.3224);
}

long double mmHg_pa(long double a)
{
    return a*(133.3224);
}

long double pa_atm(long double a)
{
    return a/(101325.0);
}

long long atm_pa(long double a)
{
    return a*(101325.0);
}

double kg_lb(double a)
{
    return a*(2.204622476);
}

double lb_kg(double a)
{
    return a/(2.204622476);
}

long double g_oz(double a)
{
    return a/(28.34952);
}

long double oz_g(double a)
{
    return a*(28.34952);
}

long double m_s_km_h(double a)
{
    return ((a*3600.0)/1000.0);
}

long double km_h_m_s(double a)
{
    return ((a*1000.0)/3600.0);
}

long double km_pc(double a)
{
    return a/(30856780000000.0);
}

long long pc_km(long double a)
{
    return a*(30856780000000.0);
}

double l_gal_UK(double a)
{
    return a/(4.54609);
}

double gal_UK_l(double a)
{
    return a*(4.54609);
}

double l_gal_US(double a)
{
    return a/(3.785412);
}

double gal_US_l(double a)
{
    return a*(3.785412);
}

